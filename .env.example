# Copy this file to a new file named exactly ".env" (no name, just the extension)
# and fill in the required values below. The .env file is where your secrets live.
# It is ignored by git (see .gitignore) so it never gets uploaded anywhere.

# An Alchemy API key for the EVM networks you plan to use. Confirm network
# availability and limits in your Alchemy dashboard before live execution.
# The direct execution path uses the chain selected by the Telegram schedule
# or CLI candidate; no browser session is required.
ALCHEMY_API_KEY=PASTE_YOUR_ALCHEMY_API_KEY_HERE

# The secret key of the wallet the bot will sign and send from.
# NEVER share this.  Keep it starting with 0x.
PRIVATE_KEY=0xPASTE_YOUR_WALLET_PRIVATE_KEY_HERE

# The public address of that same wallet (starts with 0x). Safe to share.
WALLET_ADDRESS=0xPASTE_YOUR_WALLET_PUBLIC_ADDRESS_HERE

# Optional extra signing wallets. Separate wallets with semicolons. Addresses
# are derived from each key. These keys stay on this machine and are never
# shown in Telegram or saved in schedule files.
# MINT_WALLETS=Backup:0xPRIVATE_KEY;Third:0xPRIVATE_KEY
MINT_WALLETS=

# OpenSea API key used to discover drops and build ready-to-sign mint data.
# Get one from https://opensea.io/settings/developer or the instant-key flow
# at https://docs.opensea.io/reference/api-keys. Never share it or commit the
# real .env file.
OPENSEA_API_KEY=PASTE_YOUR_OPENSEA_API_KEY_HERE

# Public SeaDrop mints use a faster direct on-chain path when the OpenSea
# preview and the contract agree. Restricted/allowlist hosted stages keep using
# their required OpenSea calldata route.
DIRECT_PUBLIC_SEADROP=true
DIRECT_SEADROP_START_TOLERANCE_SECONDS=120

# Optional extra HTTP RPC endpoints for the same chain. At launch the exact
# same signed transaction is sent to all configured endpoints concurrently.
# The configured chain endpoint stays primary for reads and preparation.
# Example:
# MINT_RPC_URLS_BASE=https://base.example-rpc-1,https://base.example-rpc-2
MINT_RPC_URLS=
# Override the primary endpoint for one network when needed. The singular URL
# is used for reads/preparation; MINT_RPC_URLS_<CHAIN> remains the fan-out list.
# MINT_RPC_URL_SOMNIA=https://your-private-somnia-rpc.example

# --- Optional Telegram control ----------------------------------------------
# Create a bot with @BotFather, then put the token here. Never commit it.
TELEGRAM_BOT_TOKEN=

# Your private Telegram chat ID. The bot ignores every other chat.
TELEGRAM_ALLOWED_CHAT_ID=

# Optional NFT mint-card and post-mint receipt look. All three can also be
# changed from Telegram Settings; Preview card shows the result immediately.
# NFT_CARD_BACKGROUND accepts a local image path or an http(s) image URL.
# Examples:
# NFT_CARD_BACKGROUND=C:\Users\YourName\Pictures\mint-card.jpg
# NFT_CARD_BACKGROUND=https://example.com/mint-card.jpg
NFT_CARD_BACKGROUND=
NFT_CARD_ACCENT_COLOR=#63E6BE
NFT_CARD_BRAND_NAME=OpenSea Mint Bot

# Live minting is disabled until you deliberately turn this on. Telegram also
# requires an explicit confirmation button or command.
ENABLE_LIVE_MINTS=false

# Maximum native coin the bot may send as mint value for one transaction.
# This is a hard ceiling, not a target. Example: 0.02 allows up to 0.02 ETH.
MAX_MINT_PRICE_NATIVE=0

# Maximum total price for one confirmed OpenSea secondary-market purchase.
# Buying is separate from minting and always has its own confirmation screen.
MAX_BUY_PRICE_NATIVE=0

# Comma-separated OpenSea chain slugs from config.py, or "all" for every
# OpenSea EVM chain. Blank also falls back to all; Solana/Hyperliquid are not
# EVM signer networks and are intentionally skipped.
MONITORED_CHAINS=all

# Daily safety limits. Paid mints remain capped by MAX_MINT_PRICE_NATIVE;
# raise that cap deliberately if you want paid mint attempts.
MAX_DAILY_MINTS=5
MAX_DAILY_GAS_NATIVE=0.05

# The daily scan window is midnight-to-midnight at this fixed UTC offset.
# 0 = UTC. For West Africa Time, use 1.
DISCOVERY_UTC_OFFSET_HOURS=0
