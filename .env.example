# Copy this file to a new file named exactly ".env" (no name, just the extension)
# and fill in the three values below. The .env file is where your secrets live.
# It is ignored by git (see .gitignore) so it never gets uploaded anywhere.

# Your Alchemy API key. ONE key works across every chain Alchemy supports
# (Ethereum, Base, Polygon, Optimism, Arbitrum, Robinhood Chain, and more) -
# you do NOT need a separate key or app per chain. Get it free at alchemy.com:
# sign up -> "Create new app" -> pick any chain, it applies to all of them ->
# copy the API key shown on the app's page (the part after "/v2/" in its urls).
# Which chain the bot actually USES is set separately in config.py
# (TARGET_CHAIN_ID) - change that per drop, not this key.
ALCHEMY_API_KEY=PASTE_YOUR_ALCHEMY_API_KEY_HERE

# The secret key of the wallet the bot will sign and send from.
# NEVER share this.  Keep it starting with 0x.
PRIVATE_KEY=0xPASTE_YOUR_WALLET_PRIVATE_KEY_HERE

# The public address of that same wallet (starts with 0x). Safe to share.
WALLET_ADDRESS=0xPASTE_YOUR_WALLET_PUBLIC_ADDRESS_HERE

# --- Optional radar settings -------------------------------------------------
# The radar works without Notion and uses radar/state/board.json instead.
# Add these three values only if you want a Notion watchlist.
#
# NOTION_TOKEN is an internal integration token. NOTION_DATABASE_ID is the ID
# of a database that belongs to you and has been shared with that integration.
# NOTION_DATABASE_URL is only used for a clickable status message.
#
# To get a token, create an internal integration in Notion. Then share your own
# database with it. The share step is required; the token alone cannot see it.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_DATABASE_URL=
