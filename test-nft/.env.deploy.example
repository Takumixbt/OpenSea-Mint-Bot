# Never commit a real deployer key. Use a dedicated low-balance test wallet.
RPC_URL=https://mainnet.base.org
DEPLOYER_PRIVATE_KEY=0xPASTE_A_DEDICATED_TEST_WALLET_KEY_HERE

# Defaults are intentionally small and bot-friendly.
MAX_SUPPLY=50
MAX_PER_WALLET=2
MINT_START_DELAY_SECONDS=120

# Set after preparing/uploading the metadata bundle. Example:
# BASE_TOKEN_URI=ipfs://<METADATA_CID>/
BASE_TOKEN_URI=

# Set this instead of the delay when you need a precise launch time.
# MINT_START_TIMESTAMP=0

# Optional explorer key for source verification.
# BASESCAN_API_KEY=PASTE_BASESCAN_KEY_HERE
